# AI Financial Analyst & Report Generator Configuration

# Relational Database (Defaults to SQLite; supports PostgreSQL)
DATABASE_URL=sqlite:///./data/financial_analyst.db
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/finance_analyst_db

# Qdrant Vector Database
QDRANT_MODE=local
QDRANT_PATH=./data/qdrant_storage
# QDRANT_MODE=server
# QDRANT_HOST=localhost
# QDRANT_PORT=6333
QDRANT_COLLECTION=financial_documents

# Embeddings & Reranking
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
ENABLE_RERANKER=true
DENSE_TOP_K=10
BM25_TOP_K=10
RRF_K=60
FINAL_TOP_K=5

# LLM Reasoning Engine
# Supported options: deterministic (no key required), gemini, openai, groq, ollama
LLM_PROVIDER=deterministic
LLM_MODEL_NAME=gemini-1.5-flash

# API Credentials (Optional - system functions deterministically without them)
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Security & Uploads
MAX_UPLOAD_SIZE_MB=50
